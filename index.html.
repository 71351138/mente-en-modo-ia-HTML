      if (yearEl) yearEl.textContent = currentYear;
      if (pledgeDateEl) {
        const today = new Date();
        pledgeDateEl.textContent = today.toLocaleDateString('es-PE', { day: '2-digit', month: 'short', year: 'numeric' });
      }

      // -----------------------------------------------------------------------
      // A. MENÚ MÓVIL RESPONSIVO
      // -----------------------------------------------------------------------
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('menu-icon-open');
      const iconClose = document.getElementById('menu-icon-close');
      const mobileLinks = document.querySelectorAll('.mobile-nav-link');

      function toggleMobileMenu() {
        const isHidden = mobileMenu.classList.contains('hidden');
        if (isHidden) {
          mobileMenu.classList.remove('hidden');
          iconOpen.classList.add('hidden');
          iconClose.classList.remove('hidden');
        } else {
          mobileMenu.classList.add('hidden');
          iconOpen.classList.remove('hidden');
          iconClose.classList.add('hidden');
        }
      }

      mobileMenuBtn.addEventListener('click', toggleMobileMenu);
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('hidden');
          iconOpen.classList.remove('hidden');
          iconClose.classList.add('hidden');
        });
      });

      // -----------------------------------------------------------------------
      // B. TABLA INTERACTIVA DE DIAGNÓSTICO (FILTRO POR ÁMBITO)
      // -----------------------------------------------------------------------
      const diagnosticData = [
        {
          category: 'global',
          finding: '1 de cada 7 jóvenes (14.3%) presenta algún trastorno mental.',
          population: 'Adolescentes 10–19 años',
          year: '2025',
          source: 'OMS'
        },
        {
          category: 'global',
          finding: 'Trastornos de ansiedad afectan al 4.1% (10–14 años) y 5.3% (15–19 años).',
          population: 'Adolescentes 10–19 años',
          year: '2025',
          source: 'OMS'
        },
        {
          category: 'peru',
          finding: '32.3% reportó algún problema de salud mental o emocional en los últimos 12 meses.',
          population: 'Jóvenes Perú 15–29 años',
          year: '2022–2023',
          source: 'ENDES / INSM'
        },
        {
          category: 'peru',
          finding: 'Mujeres jóvenes reportaron más problemas de salud mental (30.2% vs 22.9% hombres).',
          population: 'Jóvenes Perú 15–29 años',
          year: '2022–2023',
          source: 'ENDES / INSM'
        },
        {
          category: 'peru',
          finding: '1,007,470 atenciones por trastornos mentales (245,950 por ansiedad y 146,737 por depresión).',
          population: 'Establecimientos MINSA (Ene–Jul)',
          year: '2024',
          source: 'MINSA Perú'
        },
        {
          category: 'ia',
          finding: '92% usó IA en alguna forma académica (en 2024 la cifra era 66%).',
          population: 'Universitarios pregrado',
          year: '2025',
          source: 'HEPI / Kortext'
        },
        {
          category: 'ia',
          finding: '88% empleó IA generativa directamente en trabajos evaluados.',
          population: 'Universitarios pregrado',
          year: '2025',
          source: 'HEPI / Kortext'
        },
        {
          category: 'ia',
          finding: 'Orientaciones globales para proteger la autonomía y agencia humana en educación.',
          population: 'Comunidad educativa',
          year: '2023',
          source: 'UNESCO'
        }
      ];

      const tableBody = document.getElementById('diagnostic-table-body');
      const tabButtons = document.querySelectorAll('.data-tab-btn');

      function renderTable(filter = 'todos') {
        const filtered = filter === 'todos'
          ? diagnosticData
          : diagnosticData.filter(item => item.category === filter);

        tableBody.innerHTML = filtered.map(row => `
          <tr class="hover:bg-cream-100/60 transition-colors">
            <td class="py-3.5 pr-3 text-ink-900 font-medium leading-snug">${row.finding}</td>
            <td class="py-3.5 px-2 text-ink-700 whitespace-nowrap">${row.population}</td>
            <td class="py-3.5 px-2 text-ink-700 font-semibold">${row.year}</td>
            <td class="py-3.5 pl-2">
              <span class="inline-block px-2.5 py-1 rounded-lg bg-rosewater-100/80 text-coral-600 font-bold text-[11px] whitespace-nowrap">
                ${row.source}
              </span>
            </td>
          </tr>
        `).join('');
      }

      tabButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          tabButtons.forEach(b => {
            b.classList.remove('bg-white', 'text-coral-600', 'shadow-sm', 'font-bold');
            b.classList.add('text-ink-700', 'font-semibold');
          });
          btn.classList.add('bg-white', 'text-coral-600', 'shadow-sm', 'font-bold');
          btn.classList.remove('text-ink-700', 'font-semibold');
          renderTable(btn.dataset.filter);
        });
      });

      renderTable('todos');

      // -----------------------------------------------------------------------
      // C. HERRAMIENTA 1: TERMÓMETRO DE EQUILIBRIO IA
      // -----------------------------------------------------------------------
      const thermometerForm = document.getElementById('thermometer-form');
      const resultContainer = document.getElementById('thermometer-result');
      const formWarning = document.getElementById('form-warning');
      const resetBtn = document.getElementById('reset-thermometer');

      thermometerForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const formData = new FormData(thermometerForm);
        let total = 0;
        let answered = 0;

        for (let i = 1; i <= 5; i++) {
          const val = formData.get(`q${i}`);
          if (val) {
            total += parseInt(val, 10);
            answered++;
          }
        }

        if (answered < 5) {
          formWarning.classList.remove('hidden');
          return;
        }
        formWarning.classList.add('hidden');

        // Determinar perfil según puntaje (5 a 15)
        const badgeEl = document.getElementById('result-badge');
        const titleEl = document.getElementById('result-title');
        const scoreEl = document.getElementById('result-score');
        const barEl = document.getElementById('result-bar');
        const descEl = document.getElementById('result-description');
        const tipsEl = document.getElementById('result-tips');

        scoreEl.textContent = `${total} / 15 pts`;
        const percentage = Math.round((total / 15) * 100);

        let profile = {};

        if (total >= 13) {
          profile = {
            badge: 'Nivel Óptimo • Alta Autonomía',
            badgeClass: 'bg-emerald-100 text-emerald-700',
            title: 'Modo Autónomo y Consciente',
            description: '¡Excelente equilibrio! Usas la inteligencia artificial como una aliada estratégica sin ceder tu criterio propio ni dejar que la inmediatez afecte tu seguridad personal.',
            tips: [
              'Comparte tus métodos de organización y verificación crítica con tus compañeros de estudio.',
              'Mantén tus pausas activas lejos de las pantallas para cuidar tu descanso mental.',
              'Sigue cuestionando las respuestas de la IA con fuentes académicas confiables.'
            ]
          };
        } else if (total >= 9) {
          profile = {
            badge: 'Nivel Intermedio • En Construcción',
            badgeClass: 'bg-amber-100 text-amber-800',
            title: 'Modo Equilibrado (Con margen de mejora)',
            description: 'Aprovechas bien la IA para agilizar tus estudios, pero en momentos de estrés o falta de tiempo corres el riesgo de depender de sus respuestas o compararte con su rapidez.',
            tips: [
              'Aplica la regla de los 15 minutos: escribe tus propias ideas en papel antes de abrir un chat.',
              'Usa la IA como tutor para que te haga preguntas sobre un tema, en lugar de pedirle el texto resuelto.',
              'Recuerda que aprender toma tiempo: no midas tu valor por la velocidad de un algoritmo.'
            ]
          };
        } else {
          profile = {
            badge: 'Alerta Preventiva • Recupera el Timón',
            badgeClass: 'bg-rosewater-200 text-rosewater-700',
            title: 'Modo Piloto Automático',
            description: 'Es probable que la presión académica te esté llevando a delegar demasiado en la IA, lo cual puede aumentar tu ansiedad y debilitar la confianza en tus propias capacidades.',
            tips: [
              'Empieza hoy con una tarea pequeña sin usar IA: redescubre lo capaz que eres de estructurar ideas.',
              'Divide tus entregas grandes en bloques cortos para evitar la urgencia de último minuto.',
              'Conversa con tus docentes o compañeros sobre tus dudas; pedir ayuda humana reduce mucho el agobio.'
            ]
          };
        }

        badgeEl.textContent = profile.badge;
        badgeEl.className = `inline-block px-3.5 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider mb-2 ${profile.badgeClass}`;
        titleEl.textContent = profile.title;
        descEl.textContent = profile.description;
        tipsEl.innerHTML = profile.tips.map(t => `
          <li class="flex items-start gap-2.5">
            <span class="text-coral-500 font-bold mt-0.5">•</span>
            <span>${t}</span>
          </li>
        `).join('');

        resultContainer.classList.remove('hidden');
        setTimeout(() => {
          barEl.style.width = `${percentage}%`;
        }, 60);

        resultContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });

      resetBtn.addEventListener('click', () => {
        thermometerForm.reset();
        resultContainer.classList.add('hidden');
        document.getElementById('result-bar').style.width = '0%';
      });

      // -----------------------------------------------------------------------
      // D. HERRAMIENTA 2: CHECKLIST & GENERADOR DE TARJETA DE COMPROMISO
      // -----------------------------------------------------------------------
      const habitCheckboxes = document.querySelectorAll('.habit-checkbox');
      const checklistCounter = document.getElementById('checklist-counter');
      const studentNameInput = document.getElementById('student-name');
      const studentCareerInput = document.getElementById('student-career');
      const previewName = document.getElementById('preview-name');
      const previewCareer = document.getElementById('preview-career');
      const previewHabits = document.getElementById('preview-habits');

      function updatePledgePreview() {
        const checked = Array.from(habitCheckboxes).filter(cb => cb.checked);
        checklistCounter.textContent = `${checked.length} / ${habitCheckboxes.length} activos`;

        const nameVal = studentNameInput.value.trim();
        const careerVal = studentCareerInput.value.trim();

        previewName.textContent = nameVal || 'Estudiante Universitario/a';
        previewCareer.textContent = careerVal || 'Aprendizaje autónomo y bienestar digital';

        if (checked.length === 0) {
          previewHabits.innerHTML = `<li class="italic text-white/80">Marca al menos un hábito en el checklist para agregarlo a tu manifiesto.</li>`;
        } else {
          previewHabits.innerHTML = checked.map(cb => `
            <li class="flex items-start gap-2">
              <span class="font-bold text-white">✓</span>
              <span>${cb.value}</span>
            </li>
          `).join('');
        }
      }

      habitCheckboxes.forEach(cb => cb.addEventListener('change', updatePledgePreview));
      studentNameInput.addEventListener('input', updatePledgePreview);
      studentCareerInput.addEventListener('input', updatePledgePreview);
      updatePledgePreview();

      // Función de notificación Toast
      function showToast(msg) {
        const toast = document.getElementById('toast-notification');
        const toastMsg = document.getElementById('toast-message');
        toastMsg.textContent = msg;
        toast.classList.remove('hidden');
        requestAnimationFrame(() => {
          toast.classList.remove('translate-y-4', 'opacity-0');
        });
        setTimeout(() => {
          toast.classList.add('translate-y-4', 'opacity-0');
          setTimeout(() => toast.classList.add('hidden'), 300);
        }, 3200);
      }

      // Copiar Compromiso al Portapapeles (compatible con iframe/GitHub Pages)
      const copyPledgeBtn = document.getElementById('copy-pledge-btn');
      copyPledgeBtn.addEventListener('click', () => {
        const nameText = previewName.textContent;
        const careerText = previewCareer.textContent;
        const checkedHabits = Array.from(habitCheckboxes)
          .filter(cb => cb.checked)
          .map(cb => `✓ ${cb.value}`)
          .join('\n');

        const textToCopy = `🧠 MENTE EN MODO IA — "La tecnología me ayuda, mi mente decide"\n\nCompromiso de: ${nameText} (${careerText})\n\nMis hábitos digitales saludables:\n${checkedHabits || '✓ Uso responsable y pensamiento crítico activo'}\n\n#MenteEnModoIA #SaludMentalUniversitaria`;

        const tempTextarea = document.createElement('textarea');
        tempTextarea.value = textToCopy;
        tempTextarea.style.position = 'fixed';
        tempTextarea.style.opacity = '0';
        document.body.appendChild(tempTextarea);
        tempTextarea.select();
        try {
          document.execCommand('copy');
          showToast('¡Compromiso copiado al portapapeles!');
        } catch (err) {
          showToast('No se pudo copiar automáticamente.');
        }
        document.body.removeChild(tempTextarea);
      });

      // Descargar Tarjeta Visual como Imagen PNG usando HTML5 Canvas puro
      const downloadPledgeBtn = document.getElementById('download-pledge-btn');
      downloadPledgeBtn.addEventListener('click', () => {
        const canvas = document.createElement('canvas');
        canvas.width = 1080;
        canvas.height = 1080;
        const ctx = canvas.getContext('2d');

        // Fondo degradado pastel coral/rosa
        const grad = ctx.createLinearGradient(0, 0, 1080, 1080);
        grad.addColorStop(0, '#F43F5E');
        grad.addColorStop(0.55, '#F25C54');
        grad.addColorStop(1, '#E11D48');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, 1080, 1080);

        // Círculos suaves decorativos
        ctx.fillStyle = 'rgba(255, 255, 255, 0.08)';
        ctx.beginPath();
        ctx.arc(920, 160, 240, 0, Math.PI * 2);
        ctx.fill();

        ctx.beginPath();
        ctx.arc(140, 940, 200, 0, Math.PI * 2);
        ctx.fill();

        // Marco interior limpio
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.28)';
        ctx.lineWidth = 4;
        ctx.strokeRect(56, 56, 968, 968);

        // Etiqueta superior
        ctx.fillStyle = 'rgba(255, 255, 255, 0.9)';
        ctx.font = 'bold 24px sans-serif';
        ctx.fillText('PROYECTO SOCIAL • MENTE EN MODO IA', 96, 130);

        // Lema principal
        ctx.fillStyle = '#FFFFFF';
        ctx.font = '800 54px sans-serif';
        ctx.fillText('“La tecnología me ayuda,', 96, 225);
        ctx.fillText('mi mente decide.”', 96, 292);

        // Línea divisoria
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.35)';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(96, 340);
        ctx.lineTo(984, 340);
        ctx.stroke();

        // Datos del estudiante
        ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
        ctx.font = 'bold 22px sans-serif';
        ctx.fillText('COMPROMISO FIRMADO POR:', 96, 395);

        ctx.fillStyle = '#FFFFFF';
        ctx.font = 'bold 42px sans-serif';
        ctx.fillText(previewName.textContent, 96, 448);

        ctx.fillStyle = 'rgba(255, 255, 255, 0.9)';
        ctx.font = '26px sans-serif';
        ctx.fillText(previewCareer.textContent, 96, 490);

        // Lista de hábitos
        ctx.fillStyle = 'rgba(255, 255, 255, 0.9)';
        ctx.font = 'bold 24px sans-serif';
        ctx.fillText('MIS HÁBITOS DIGITALES SALUDABLES:', 96, 570);

        const selectedHabits = Array.from(habitCheckboxes)
          .filter(cb => cb.checked)
          .map(cb => cb.value);

        const habitsToDraw = selectedHabits.length > 0
          ? selectedHabits
          : ['Mantengo mi pensamiento crítico y autonomía académica.'];

        ctx.font = '25px sans-serif';
        let currentY = 625;

        // Función auxiliar para envolver texto largo en Canvas
        function wrapText(text, x, y, maxWidth, lineHeight) {
          const words = text.split(' ');
          let line = '✓ ';
          for (let n = 0; n < words.length; n++) {
            const testLine = line + words[n] + ' ';
            const metrics = ctx.measureText(testLine);
            if (metrics.width > maxWidth && n > 0) {
              ctx.fillText(line, x, y);
              line = '   ' + words[n] + ' ';
              y += lineHeight;
            } else {
              line = testLine;
            }
          }
          ctx.fillText(line, x, y);
          return y + lineHeight + 12;
        }

        habitsToDraw.slice(0, 5).forEach(habit => {
          currentY = wrapText(habit, 96, currentY, 880, 34);
        });

        // Pie de tarjeta
        ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
        ctx.font = '22px sans-serif';
        ctx.fillText('Salud Mental & Uso Responsable de la IA • Universitarios 18–25 años', 96, 980);

        // Descargar archivo PNG
        const link = document.createElement('a');
        link.download = 'compromiso-mente-en-modo-ia.png';
        link.href = canvas.toDataURL('image/png');
        link.click();

        showToast('¡Tarjeta descargada como imagen PNG!');
      });
    });
  </script>
</body>
</html>
